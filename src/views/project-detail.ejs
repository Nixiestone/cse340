<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p><%= project.description %></p>
    <p>Location: <%= project.location %> | Date: <%= project.project_date.toLocaleDateString() %></p>
    <p>Hosted by: <%= project.organization_name %></p>

    <h2>Categories</h2>
    <ul>
        <% categories.forEach(cat => { %>
            <li><a href="/categories/<%= cat.category_id %>"><%= cat.category_name %></a></li>
        <% }) %>
    </ul>

    <p><a href="/projects">← Back to all projects</a></p>
</main>

<%- include('partials/footer') %>