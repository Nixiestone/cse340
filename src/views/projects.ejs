<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= project.project_name %></strong> (<%= project.category_name %>) — hosted by <%= project.organization_name %>
                <p><%= project.description %></p>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>