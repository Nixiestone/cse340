<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <strong><%= project.project_name %></strong>
                </a> — <%= project.category_names %>
                <p><%= project.description %></p>
                <p>Location: <%= project.location %> | Date: <%= project.project_date.toLocaleDateString() %></p>
                <p>Hosted by: <%= project.organization_name %></p>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>