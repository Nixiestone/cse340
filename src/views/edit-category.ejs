<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= categoryDetails.category_name %>"
                maxlength="100"
                required
            />
        </div>

        <button type="submit">Update Category</button>
    </form>

    <p><a href="/category/<%= categoryDetails.category_id %>">← Back to category</a></p>
</main>

<%- include('partials/footer') %>