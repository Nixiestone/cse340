<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% categories.forEach(cat => { %>
            <li><a href="/category/<%= cat.category_id %>"><%= cat.category_name %></a></li>
        <% }) %>
    </ul>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-category">Add a New Category</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>