<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>
        </ul>
    </nav>

    <%# Show any flash messages queued by the previous request, then they are cleared %>
    <% const messages = typeof flash === 'function' ? flash() : {}; %>
    <% Object.keys(messages).forEach(type => { %>
        <% messages[type].forEach(message => { %>
            <div class="alert alert-<%= type %>" role="<%= type === 'error' ? 'alert' : 'status' %>"><%= message %></div>
        <% }); %>
    <% }); %>