<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(org => { %>
            <li>
                <a href="/organization/<%= org.organization_id %>">
                    <img src="/images/<%= org.logo %>" alt="">
                    <strong><%= org.organization_name %></strong>
                </a>: <%= org.contact_email %>
                <p><%= org.description %></p>
            </li>
        <% }) %>
    </ul>

    <p><a href="/new-organization">Add a new organization</a></p>
</main>

<%- include('partials/footer') %>