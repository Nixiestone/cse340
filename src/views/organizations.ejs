<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(org => { %>
            <li>
                <img src="/images/<%= org.logo %>" alt="<%= org.organization_name %> logo">
                <strong><%= org.organization_name %></strong>: <%= org.contact_email %>
                <p><%= org.description %></p>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>