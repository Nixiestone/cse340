<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <img class="org-logo" src="/images/<%= organization.logo %>" alt="<%= organization.organization_name %> logo">
    <p><strong>Contact:</strong> <%= organization.contact_email %></p>
    <p><%= organization.description %></p>

    <h2>Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/projects/<%= project.project_id %>"><%= project.project_name %></a>
                <p><%= project.description %></p>
            </li>
        <% }) %>
    </ul>

    <p><a href="/organizations">← Back to all organizations</a></p>
</main>

<%- include('partials/footer') %>